node_modules/
# Постоянное хранилище админ-панели: база контента и загруженные файлы. Меняется во время работы
# сервера, в репозиторий не попадает. Исходные тексты для первичного заполнения лежат в data/seed/.
var/
.next/
out/
dist/
coverage/
playwright-report/
test-results/
# Скриншоты браузерной приёмки: рабочий материал проверок, не часть сайта. Около 140 МБ картинок,
# которые иначе навсегда осели бы в истории и замедлили клонирование. Лежат локально.
artifacts/
.env
.env.local
.env.*.local
# Заполненный файл секретов сервера. В git попадает только образец .env.production.example.
.env.production
CLAUDE.local.md
.claude/settings.local.json
.claude/scheduled_tasks.lock
.DS_Store
Thumbs.db
*.log
next-env.d.ts
*.tsbuildinfo
