# Скопируйте этот файл в .env.local и подставьте свои значения. .env.local в git не попадает.
#
# ВАЖНО: ни одной переменной ниже нельзя давать префикс NEXT_PUBLIC_ — он публикует значение в
# клиентский бандл, то есть отдаёт секрет каждому посетителю сайта. Всё, что здесь перечислено,
# читается ТОЛЬКО серверным кодом.


# ─────────────────────────────────────────────────────────────────────────────────────────────
# Админ-панель: вход и сессии (обязательно, иначе /login отвечает «Вход не настроен»)
# ─────────────────────────────────────────────────────────────────────────────────────────────
#
# ADMIN_LOGIN         — логин единственного администратора.
# ADMIN_PASSWORD_HASH — ХЕШ пароля целиком, вместе с префиксом «scrypt:». Сам пароль сюда не
#                       вписывается: этот файл — образец, он попадает в git.
#                       Получить: npm run admin:hash-password
# SESSION_SECRET      — случайная строка не короче 32 символов; ею подписывается cookie сессии.
#                       Смена значения завершает все открытые сессии.
#                       Получить: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Значения вставляются как есть, без кавычек. Внутри них не должно быть знака `$`: Next.js
# раскрывает `$переменные` в .env-файлах, и подставленное значение молча испортилось бы. Поэтому
# части хеша разделены двоеточием, а не долларом, как в канонической записи scrypt.

ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=


# ─────────────────────────────────────────────────────────────────────────────────────────────
# Доверие обратному прокси — ВАЖНО для защиты от подбора пароля
# ─────────────────────────────────────────────────────────────────────────────────────────────
#
# TRUST_PROXY=1 разрешает приложению определять адрес посетителя по заголовку X-Forwarded-For.
#
# Ставить ТОЛЬКО если приложение недоступно из интернета напрямую и стоит за обратным прокси,
# который этот заголовок контролирует:
#
#     proxy_set_header X-Forwarded-For $remote_addr;   # перезапись — предпочтительно
#     proxy_set_header Host            $host;          # нужен для проверки Origin в админ-API
#
# Почему это существенно. Заголовок X-Forwarded-For ставит КЛИЕНТ. Если приложение доступно
# напрямую, а TRUST_PROXY=1, то подбирающий пароль присылает новое значение на каждый запрос,
# счётчик неудачных попыток всякий раз заводится заново и порог не достигается никогда.
#
# Если переменная НЕ задана, адрес считается неизвестным: все попытки входа складываются в один
# общий счётчик. Это безопасно по умолчанию, но означает, что поток неудачных попыток извне
# закроет вход и владельцу сайта. Поэтому production без обратного прокси не рекомендуется —
# см. PRE_RELEASE_CHECKLIST.md, разделы A1 и A3.

TRUST_PROXY=


# ─────────────────────────────────────────────────────────────────────────────────────────────
# Хранилище контента (необязательно — есть значения по умолчанию)
# ─────────────────────────────────────────────────────────────────────────────────────────────
#
# QBIT_DATA_DIR    — корень постоянных данных. По умолчанию ./var
# QBIT_DB_PATH     — файл базы SQLite. По умолчанию <QBIT_DATA_DIR>/content.db
# QBIT_UPLOADS_DIR — директория загруженных файлов. По умолчанию <QBIT_DATA_DIR>/uploads
#
# На production обе директории должны лежать на постоянном томе: при выкате нового кода они не
# должны перезаписываться, иначе тексты и документы будут теряться при каждом деплое.

QBIT_DATA_DIR=
QBIT_DB_PATH=
QBIT_UPLOADS_DIR=


# ─────────────────────────────────────────────────────────────────────────────────────────────
# Форма «Ваша задача» → Telegram
# ─────────────────────────────────────────────────────────────────────────────────────────────
#
# TELEGRAM_BOT_TOKEN — токен бота от @BotFather (формат 123456789:AA...).
# TELEGRAM_CHAT_ID   — куда доставлять заявки: ваш личный chat_id либо id группы/канала.
#
# Обе переменные читаются только серверным кодом (src/app/api/task/route.ts).
# Пока они не заданы, форма честно отвечает ошибкой и не притворяется, что письмо ушло.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ─────────────────────────────────────────────────────────────────────────────────────────────
# Форма заявки на странице /contacts → n8n
# ─────────────────────────────────────────────────────────────────────────────────────────────
#
# N8N_CONTACT_WEBHOOK_URL    — адрес production-webhook сценария n8n, принимающего заявку.
#                              Сценарий «Qbit_sait/Webhook → Telegram notification», путь webhook —
#                              webhook-telegram-notification, то есть адрес имеет вид
#                              https://<ваш-n8n>/webhook/webhook-telegram-notification
#                              Именно /webhook/, а не /webhook-test/: тестовый адрес работает только
#                              при нажатой в n8n кнопке «Listen for test event».
# N8N_CONTACT_WEBHOOK_SECRET — общий секрет; уходит в заголовке X-QBit-Webhook-Secret, и сценарий
#                              n8n должен отклонять запросы без него.
#
# Браузер отправляет форму на собственный роут /api/contact, а не на n8n, поэтому адрес и секрет
# в клиент не попадают. Пока N8N_CONTACT_WEBHOOK_URL не задан, роут честно отвечает 503, а форма
# показывает ошибку и прямые контакты — она не притворяется, что заявка ушла.

N8N_CONTACT_WEBHOOK_URL=
N8N_CONTACT_WEBHOOK_SECRET=
