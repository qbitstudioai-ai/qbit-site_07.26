# Образец файла секретов для сервера.
#
# На сервере он лежит по пути /opt/allqbit-data/production.env с правами 600 и в git не попадает.
# Этот образец — только имена переменных и пояснения; значений здесь нет и быть не должно.
#
# Ни одной переменной нельзя давать префикс NEXT_PUBLIC_ — он публикует значение в браузер.
# Значения пишутся как есть, без кавычек, и не должны содержать знак `$`.


# ─── Вход в админ-панель (обязательно) ─────────────────────────────────────────────────────────
#
# Без этих трёх переменных /login отвечает «Вход не настроен».
#
# ADMIN_PASSWORD_HASH — не пароль, а хеш целиком, вместе с префиксом «scrypt:».
#                       Получить:  npm run admin:hash-password
# SESSION_SECRET      — случайная строка не короче 32 символов. Смена завершает все сессии.
#                       Получить:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=


# ─── Форма «Ваша задача» → Telegram ────────────────────────────────────────────────────────────
#
# Токен от @BotFather и chat_id получателя. Пока не заданы, форма честно показывает ошибку
# и не притворяется, что сообщение ушло.
#
# Прежний токен старого сайта удалён вместе с ним 29.07.2026 — бот заводится заново.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ─── Форма заявки на /contacts → n8n ───────────────────────────────────────────────────────────
#
# Адрес production-webhook (именно /webhook/, а не /webhook-test/) и общий секрет.
# Пока не задан, роут отвечает 503, а форма показывает прямые контакты.

N8N_CONTACT_WEBHOOK_URL=
N8N_CONTACT_WEBHOOK_SECRET=


# ─── Не задавайте здесь ────────────────────────────────────────────────────────────────────────
#
# QBIT_DATA_DIR и TRUST_PROXY уже выставлены в compose.yml. Дублировать их тут бесполезно:
# секция `environment:` в Compose имеет приоритет над env_file, поэтому написанное здесь молча
# не подействует — и на это можно потратить час поисков. Менять их нужно в compose.yml.
