# Что НЕ уходит в контекст сборки образа.
#
# Смысл файла не только в скорости: сюда попадают и секреты. `.env.local` с токенами обязан
# остаться на машине разработчика — переменные production задаются на сервере через env_file.

node_modules
.next
out
dist
coverage

# Секреты. Никогда не должны оказаться в слое образа.
.env
.env.local
.env.*.local

# Постоянные данные админ-панели: база и загруженные файлы живут на томе сервера, а не в образе.
var

# Результаты проверок и рабочие материалы.
playwright-report
test-results
artifacts
reports
references
archive
*.tsbuildinfo
*.log

# История и настройки инструментов.
.git
.github
.claude
.vscode

# Документация проекта: на работу собранного сайта не влияет.
docs
prompts
*.md
!README.md

# Тесты не нужны в образе — они прогоняются до сборки.
src/tests
playwright.config.ts
vitest.config.ts
